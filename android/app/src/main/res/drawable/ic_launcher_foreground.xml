        android:strokeWidth="7.5" android:strokeLineCap="round" android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="36" android:startY="74" android:endX="74" android:endY="34">
                <item android:offset="0" android:color="#FF6576FF" />
                <item android:offset="0.42" android:color="#FF9A86FF" />
                <item android:offset="0.72" android:color="#FFF08C9A" />
                <item android:offset="1" android:color="#FFFFB25E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- moon glow -->
    <path android:pathData="M62.321,41.144a7,7 0 1,0 14,0a7,7 0 1,0 -14,0z">
